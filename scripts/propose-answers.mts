function isFive(w: string): boolean {
  return [...w].length === 5;
}

const proposed = new Map<string, string>();

for (const pretty of curated) {
  const norm = normalizeWord(pretty);
  if (!isFive(norm)) continue;
  if (answerSet.has(norm)) continue;
  if (answerPretty.has(pretty)) continue;
  proposed.set(norm, pretty);
}

const curatedList = [...proposed.entries()]
  .map(([norm, pretty]) => ({ norm, pretty }))
  .sort((a, b) => a.pretty.localeCompare(b.pretty, "ar"));

// Extra noun-like from VALID_GUESSES
const extras: { norm: string; pretty: string }[] = [];
for (const g of VALID_GUESSES) {
  if (!isFive(g)) continue;
  if (answerSet.has(g) || proposed.has(g)) continue;
  if (!(g.endsWith("ه") || g.endsWith("ة"))) continue;
  if (/^(ات|ب|ل|ف|و|ي|ن|س|ك)/.test(g) && !g.startsWith("م")) continue;
  extras.push({ norm: g, pretty: g });
}

console.log("answers now", ANSWERS.length);
console.log("need for ~700", 700 - ANSWERS.length);
console.log("curated new 5-letter", curatedList.length);
console.log("extra guess nouns", extras.length);

// Batch 1: curated everyday words first (~150)
const batch1 = curatedList.slice(0, 150);
console.log("\n=== الدفعة 1 للمراجعة (" + batch1.length + ") ===");
console.log(batch1.map((x) => x.pretty).join("، "));
console.log("\nبعدها يصير العدد تقريباً", ANSWERS.length + batch1.length);
