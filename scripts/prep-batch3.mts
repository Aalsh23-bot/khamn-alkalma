const batchMap = new Map<string, string>();

function consider(pretty: string) {
  if (DROP.has(pretty)) return;
  const n = normalizeWord(pretty);
  if ([...n].length !== 5) return;
  if (answerSet.has(n) || prettySet.has(pretty)) return;
  if (DROP.has(n)) return;
  if (batchMap.has(n)) return;
  batchMap.set(n, pretty);
}

for (const w of [...curated, ...more]) consider(w);

// Mine VALID_GUESSES for clean مـ…ة nouns only (lemma-like)
const badSuffix = /(تك|ته|هم|كم|نا|ني|ها|وه|اه)$/;
const verbish = /^(ات|است|ان)[بتثجحخدذرزسشصضطظعغفقكلمنهي]/;
for (const g of VALID_GUESSES) {
  if ([...g].length !== 5) continue;
  if (!g.startsWith("م")) continue;
  if (!(g.endsWith("ه") || g.endsWith("ة"))) continue;
  if (badSuffix.test(g)) continue;
  if (verbish.test(g)) continue;
  // skip forms that look like participles we already rejected loosely
  if (/^(مت|مست)/.test(g) && /(ة|ه)$/.test(g)) {
    // allow some common ones only
    const allow = new Set([
      "متاحه",
      "متصلة",
      "متجهه",
      "مثيرة",
      "مجهزة",
      "محددة",
      "مخلصة",
      "مذهلة",
      "مزعجة",
      "مصابة",
      "مطلقة",
      "مظلمة",
      "معطلة",
      "مميزة",
      "مهتمة",
      "مهددة",
    ]);
    const prettyTry = g.endsWith("ه") ? g.slice(0, -1) + "ة" : g;
    if (!allow.has(g) && !allow.has(prettyTry)) continue;
  }
  const pretty = g.endsWith("ه") ? g.slice(0, -1) + "ة" : g;
  if (DROP.has(pretty) || DROP.has(g)) continue;
  // skip very rare letter bombs
  const rare = [...normalizeWord(pretty)].filter((c) => "ظذزضثصط".includes(c)).length;
  if (rare >= 2) continue;
  consider(pretty);
}

const batch = [...batchMap.entries()]
  .map(([n, p]) => ({ n, p }))
  .sort((a, b) => a.p.localeCompare(b.p, "ar"));

const need = 1000 - ANSWERS.length;
console.log("answers", ANSWERS.length);
console.log("candidates", batch.length);
console.log("need", need);

// take up to need
const take = batch.slice(0, Math.min(need, batch.length));
console.log("taking", take.length, "→ reach", ANSWERS.length + take.length);
console.log(take.map((x) => x.p).join("، "));
writeFileSync("/tmp/batch3.json", JSON.stringify(take));
