# =============================================================================
# خمن الكلمة — متغيرات البيئة
# انسخ هذا الملف إلى `.env` واملأ القيم من لوحة Supabase.
# =============================================================================

# من: Project Settings → API
# Project URL
VITE_SUPABASE_URL=https://eqxaivexuowngyigmqwl.supabase.co

# من: Project Settings → API → Project API keys → anon public
# آمن للاستخدام في التطبيق (محمي بـ RLS)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# RevenueCat public SDK keys (safe in the app). Create app + offerings in RevenueCat dashboard.
# VITE_REVENUECAT_IOS_API_KEY=appl_xxx
# VITE_REVENUECAT_ANDROID_API_KEY=goog_xxx

# --- لاحقاً (Edge Functions / سيرفر فقط — لا تضعها في التطبيق) ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# RESEND_API_KEY=re_xxx
# REVENUECAT_SECRET_KEY=sk_xxx
